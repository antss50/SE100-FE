# Bật mock adapter (src/mocks): mọi request xử lý trong trình duyệt, không gọi backend.
# false = chỉ gọi API thật; lỗi mạng hiện ra, KHÔNG rơi về mock.
VITE_USE_MOCK=false

# Độ trễ mock (ms). 0 = tắt (dùng cho test); bỏ trống = ngẫu nhiên 150–300 ms.
VITE_MOCK_DELAY_MS=

# Địa chỉ backend cho proxy `/api` của Vite dev server (khi VITE_USE_MOCK=false)
VITE_BACKEND_URL=http://localhost:3000

# Đường dẫn gốc API (mặc định `/api/v1`)
VITE_API_BASE_URL=/api/v1
